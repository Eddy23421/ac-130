-- 6. SURVIVOR ESP
local function updatePlayerESP(player, g1Id, g2Id)
    if player == LocalPlayer then return end
    if player.UserId == g1Id or player.UserId == g2Id then
        if espRegistry[player] then
            if espRegistry[player].highlight then espRegistry[player].highlight.Enabled = false end
            if espRegistry[player].billboard then espRegistry[player].billboard.Enabled = false end
        end
        return
    end

    local char = player.Character
    if not char then
        if espRegistry[player] then
            if espRegistry[player].highlight then espRegistry[player].highlight:Destroy() end
            if espRegistry[player].billboard then espRegistry[player].billboard:Destroy() end
            espRegistry[player] = nil
        end
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        if espRegistry[player] then
            if espRegistry[player].highlight then espRegistry[player].highlight.Enabled = false end
            if espRegistry[player].billboard then espRegistry[player].billboard.Enabled = false end
        end
        return
    end

    local entry = espRegistry[player]
    if not entry then
        local hl = Instance.new("Highlight")
        hl.Name = "ESP_Highlight"
        hl.Adornee = char
        hl.FillColor = Color3.fromRGB(0, 180, 255)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.65
        hl.OutlineTransparency = 0.2
        hl.Enabled = settings.showESP
        hl.Parent = visualFolder

        local bb = Instance.new("BillboardGui")
        bb.Name = "ESP_Billboard"
        bb.Adornee = hrp
        bb.Size = UDim2.new(0, 140, 0, 32)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Enabled = settings.showESP
        bb.Parent = visualFolder

        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Font = Enum.Font.GothamBold
        text.TextSize = 11
        text.TextColor3 = Color3.fromRGB(255, 255, 255)
        text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        text.TextStrokeTransparency = 0.3
        text.Parent = bb

        entry = { highlight = hl, billboard = bb, label = text }
        espRegistry[player] = entry
    end

    if char.Parent and entry.highlight.Adornee ~= char then
        entry.highlight.Adornee = char
        entry.billboard.Adornee = hrp
    end

    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local dist = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0

    local hpPct = math.clamp(hum.Health / (hum.MaxHealth > 0 and hum.MaxHealth or 100), 0, 1)
    local col = hpPct > 0.5 and Color3.fromRGB(80, 220, 120) or (hpPct > 0.25 and Color3.fromRGB(255, 180, 40) or Color3.fromRGB(255, 60, 60))

    entry.label.Text = string.format("%s (%d HP) | %.0fm", player.DisplayName, math.floor(hum.Health), dist)
    entry.label.TextColor3 = col
    entry.highlight.FillColor = col
    entry.highlight.Enabled = settings.showESP
    entry.billboard.Enabled = settings.showESP
end

-- 7. DUAL COVER & NAVIGATION GUIDANCE
local lastCoverScan = 0
local nearestSafePos = nil
local nearestSafeDist = 9999
local coverFromG1 = false
local coverFromG2 = false

local function getCardinalDirection(fromPos, toPos)
    local diff = toPos - fromPos
    local angle = math.atan2(diff.X, diff.Z)
    local deg = math.deg(angle)
    if deg < 0 then deg = deg + 360 end

    if deg >= 337.5 or deg < 22.5 then return "SOUTH"
    elseif deg >= 22.5 and deg < 67.5 then return "SOUTH-EAST"
    elseif deg >= 67.5 and deg < 112.5 then return "EAST"
    elseif deg >= 112.5 and deg < 157.5 then return "NORTH-EAST"
    elseif deg >= 157.5 and deg < 202.5 then return "NORTH"
    elseif deg >= 202.5 and deg < 247.5 then return "NORTH-WEST"
    elseif deg >= 247.5 and deg < 292.5 then return "WEST"
    else return "SOUTH-WEST" end
end

local function scanDualCover(myPos, plane1Pos, plane2Pos, isG2Active)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character, visualFolder }

    local hit1 = workspace:Raycast(myPos, plane1Pos - myPos, params)
    coverFromG1 = (hit1 ~= nil)

    if isG2Active then
        local hit2 = workspace:Raycast(myPos, plane2Pos - myPos, params)
        coverFromG2 = (hit2 ~= nil)
    else
        coverFromG2 = true
    end

    local fullyCovered = coverFromG1 and coverFromG2
    nearestSafeDist = 9999
    nearestSafePos = nil

    if fullyCovered then
        nearestSafePos = myPos
        nearestSafeDist = 0
        return
    end

    for angle = 0, 315, 45 do
        local rad = math.rad(angle)
        for r = 8, 32, 8 do
            local testPos = myPos + Vector3.new(math.cos(rad) * r, 0, math.sin(rad) * r)
            local safe1 = workspace:Raycast(testPos, plane1Pos - testPos, params) ~= nil
            local safe2 = (not isG2Active) or (workspace:Raycast(testPos, plane2Pos - testPos, params) ~= nil)

            if safe1 and safe2 then
                local d = (testPos - myPos).Magnitude
                if d < nearestSafeDist then
                    nearestSafeDist = d
                    nearestSafePos = testPos
                end
                break
            end
        end
    end
end

local function getGunnerName(userId, fallback)
    if not userId or userId == 0 then return fallback end
    local p = Players:GetPlayerByUserId(userId)
    if p then return p.DisplayName end
    return fallback
end

-- 8. AUTO-DODGE & AUTO-EXTRACT EXECUTION
local lastDodgeTime = 0

local function performAutoDodge(myPos, hum)
    if not settings.autoDodge or not hum or hum.Health <= 0 then return false end

    -- Check all incoming projectiles
    local imminentImpact = nil
    local minDangerDist = 999

    for _, p in pairs(activeProjectiles) do
        if p.impactPos then
            local dist = (Vector3.new(p.impactPos.X, myPos.Y, p.impactPos.Z) - myPos).Magnitude
            local dangerRadius = (p.radius or 12) + 6
            if dist < dangerRadius and dist < minDangerDist then
                imminentImpact = p
                minDangerDist = dist
            end
        end
    end

    -- If shell is landing directly on us, dodge away!
    if imminentImpact then
        local blastPos = imminentImpact.impactPos
        local awayDir = Vector3.new(myPos.X - blastPos.X, 0, myPos.Z - blastPos.Z)
        if awayDir.Magnitude < 0.1 then
            awayDir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
        end
        awayDir = awayDir.Unit

        local dodgeTarget = blastPos + awayDir * ((imminentImpact.radius or 12) + 14)
        hum:MoveTo(dodgeTarget)
        lastDodgeTime = os.clock()
        return true
    end

    return false
end

local function performAutoExtract(myPos, hum, char)
    if not settings.autoExtract or not hum or hum.Health <= 0 then return end
    if char:GetAttribute("Extracted") == true then
        extractStatusLabel.Text = "EXTRACTION: EXTRACTED ✅"
        extractStatusLabel.TextColor3 = Color3.fromRGB(80, 255, 140)
        extractReticle.Transparency = 1
        extractBox.Visible = false
        return
    end

    local lz = GameState:GetAttribute("ExtractionLZ")
    local extFolder = workspace:FindFirstChild("Extraction")
    local heli = extFolder and extFolder:FindFirstChild("ExtractionHeli")
    local targetPos = lz or (heli and heli.PrimaryPart and heli.PrimaryPart.Position)

    if targetPos then
        local distToLZ = (Vector3.new(targetPos.X, myPos.Y, targetPos.Z) - myPos).Magnitude
        extractReticle.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, 0, math.rad(90))
        extractReticle.Transparency = 0.25
        extractBox.Visible = true

        extractStatusLabel.Text = string.format("EXTRACTION: LZ ACTIVE (%.0f studs)", distToLZ)
        extractStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)

        -- Don't override if currently dodging an imminent shell
        if os.clock() - lastDodgeTime > 0.4 then
            if distToLZ > 5 then
                hum:MoveTo(targetPos)
            end
        end
    else
        extractReticle.Transparency = 1
        extractBox.Visible = false
        extractStatusLabel.Text = "EXTRACTION: AWAITING LZ"
        extractStatusLabel.TextColor3 = Color3.fromRGB(150, 160, 175)
    end
end

