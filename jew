        local myPos = hrp.Position
        local dist1 = (Vector3.new(aim1.X, myPos.Y, aim1.Z) - myPos).Magnitude
        local dist2 = isG2Active and (Vector3.new(aim2.X, myPos.Y, aim2.Z) - myPos).Magnitude or 9999

        gCard1.titleLbl.Text = "GUNNER #1: " .. getGunnerName(g1Id, "Alpha")
        gCard1.wpnLbl.Text = string.format("Weapon: %s (Radius: %d studs)", wpn1.name, wpn1.radius)
        gCard1.distBar.Text = string.format("Crosshair Distance: %.1f studs", dist1)
        gCard1.distBar.TextColor3 = (dist1 <= wpn1.radius) and Color3.fromRGB(255, 60, 60) or ((dist1 <= wpn1.radius + 35) and Color3.fromRGB(255, 180, 50) or Color3.fromRGB(100, 220, 140))

        if isG2Active then
            gCard2.titleLbl.Text = "GUNNER #2: " .. getGunnerName(g2Id, "Bravo")
            gCard2.wpnLbl.Text = string.format("Weapon: %s (Radius: %d studs)", wpn2.name, wpn2.radius)
            gCard2.distBar.Text = string.format("Crosshair Distance: %.1f studs", dist2)
            gCard2.distBar.TextColor3 = (dist2 <= wpn2.radius) and Color3.fromRGB(255, 60, 60) or ((dist2 <= wpn2.radius + 35) and Color3.fromRGB(255, 180, 50) or Color3.fromRGB(100, 220, 140))
        else
            gCard2.titleLbl.Text = "GUNNER #2: INACTIVE"
            gCard2.wpnLbl.Text = "Only 1 gunship deployed."
            gCard2.distBar.Text = "Standby"
            gCard2.distBar.TextColor3 = Color3.fromRGB(120, 125, 135)
        end

        -- Dual Cover Scan
        local now = os.clock()
        if now - lastCoverScan > 0.15 then
            lastCoverScan = now
            scanDualCover(myPos, plane1Pos, plane2Pos, isG2Active)
        end

        -- Cover Status
        if coverFromG1 and coverFromG2 then
            coverStatusLabel.Text = "COVER: 100% PROTECTED (BLINDSPOT)"
            coverStatusLabel.TextColor3 = Color3.fromRGB(70, 255, 130)
            navGuideLabel.Text = "Position safe from all overhead line of sight."
            coverPillar.Transparency = 1
            coverBox.Visible = false
        else
            if not coverFromG1 and coverFromG2 then
                coverStatusLabel.Text = "COVER: EXPOSED TO GUNNER #1"
                coverStatusLabel.TextColor3 = Color3.fromRGB(255, 160, 50)
            elseif coverFromG1 and not coverFromG2 then
                coverStatusLabel.Text = "COVER: EXPOSED TO GUNNER #2"
                coverStatusLabel.TextColor3 = Color3.fromRGB(255, 160, 50)
            else
                coverStatusLabel.Text = "COVER: FULLY EXPOSED TO SKY!"
                coverStatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
            end

            if nearestSafePos and settings.showCoverWaypoint then
                local compassDir = getCardinalDirection(myPos, nearestSafePos)
                navGuideLabel.Text = string.format("Run %s towards safe blindspot (%.0f studs)", compassDir, nearestSafeDist)
                coverPillar.CFrame = CFrame.new(nearestSafePos) * CFrame.Angles(0, 0, math.rad(90))
                coverPillar.Transparency = 0.3
                coverBox.Visible = true
            else
                navGuideLabel.Text = "No full blindspot nearby. Stay low!"
                coverPillar.Transparency = 1
                coverBox.Visible = false
            end
        end

        -- AUTO-DODGE & AUTO-EXTRACT
        local isDodging = performAutoDodge(myPos, hum)
        if not isDodging then
            -- Crosshair proximity dodge check (if gunner is aiming right on your head)
            local gunnerAimDanger = (dist1 < wpn1.radius + 4) or (isG2Active and dist2 < wpn2.radius + 4)
            if settings.autoDodge and gunnerAimDanger then
                local dangerAim = (dist1 < wpn1.radius + 4) and aim1 or aim2
                local awayDir = Vector3.new(myPos.X - dangerAim.X, 0, myPos.Z - dangerAim.Z)
                if awayDir.Magnitude < 0.1 then awayDir = Vector3.new(1, 0, 0) end
                hum:MoveTo(dangerAim + awayDir.Unit * (wpn1.radius + 14))
                isDodging = true
            end
        end

        if not isDodging then
            performAutoExtract(myPos, hum, char)
        end
    end

    if settings.showESP then
        for _, p in ipairs(Players:GetPlayers()) do
            updatePlayerESP(p, g1Id, g2Id)
        end
    end
end)

