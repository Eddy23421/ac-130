local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = {
    workspace:FindFirstChild("GunshipVisual"),
    workspace:FindFirstChild("GunshipVisual2"),
    workspace.CurrentCamera,
    visualFolder
}

local function solveBallisticImpact(origin, vel)
    local gravity = Vector3.new(0, -35, 0)
    local prev = origin
    local impactPoint = nil
    local flightTime = 2

    for step = 1, 300 do
        local t = step * 0.01
        local curr = origin + vel * t + 0.5 * gravity * t * t
        local hit = workspace:Raycast(prev, curr - prev, rayParams)
        if hit then
            impactPoint = hit.Position
            flightTime = t
            break
        end
        prev = curr
    end

    if not impactPoint then
        impactPoint = prev
    end
    return impactPoint, flightTime
end

local activeTracerPool = 0
local maxTracers = 18

local function onProjectileFired(projId, weaponId, origin, vel, t0)
    local wpn = WEAPONS[weaponId] or { name = "Shell", radius = 10, color = Color3.fromRGB(255, 120, 60) }
    local impactPos, flightTime = solveBallisticImpact(origin, vel)

    if settings.showBallistics and not (activeTracerPool >= maxTracers and weaponId == 1) then
        activeTracerPool = activeTracerPool + 1
        local pModel = Instance.new("Model")
        pModel.Name = "Proj_" .. tostring(projId)
        pModel.Parent = visualFolder

        local bulletBead = sanitizePart(Instance.new("Part"))
        bulletBead.Shape = Enum.PartType.Ball
        bulletBead.Size = Vector3.new(1.8, 1.8, 1.8)
        bulletBead.CFrame = CFrame.new(origin)
        bulletBead.Material = Enum.Material.Neon
        bulletBead.Color = wpn.color
        bulletBead.Parent = pModel

        local a0 = Instance.new("Attachment")
        a0.Position = Vector3.new(0, 0.4, 0)
        a0.Parent = bulletBead

        local a1 = Instance.new("Attachment")
        a1.Position = Vector3.new(0, -0.4, 0)
        a1.Parent = bulletBead

        local trail = Instance.new("Trail")
        trail.Attachment0 = a0
        trail.Attachment1 = a1
        trail.Color = ColorSequence.new(wpn.color)
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(1, 1)
        })
        trail.Lifetime = 0.35
        trail.LightEmission = 1
        trail.FaceCamera = true
        trail.Parent = bulletBead

        local landRing = sanitizePart(Instance.new("Part"))
        landRing.Shape = Enum.PartType.Cylinder
        landRing.Size = Vector3.new(0.3, wpn.radius * 2, wpn.radius * 2)
        landRing.CFrame = CFrame.new(impactPos) * CFrame.Angles(0, 0, math.rad(90))
        landRing.Material = Enum.Material.ForceField
        landRing.Color = wpn.color
        landRing.Transparency = 0.25
        landRing.Parent = pModel

        local ringBox = Instance.new("SelectionBox")
        ringBox.Adornee = landRing
        ringBox.Color3 = wpn.color
        ringBox.LineThickness = 0.05
        ringBox.Parent = landRing

        local projRecord = {
            model = pModel,
            bulletBead = bulletBead,
            landRing = landRing,
            origin = origin,
            vel = vel,
            t0 = t0 or workspace:GetServerTimeNow(),
            impactPos = impactPos,
            flightTime = flightTime,
            color = wpn.color,
            radius = wpn.radius
        }
        activeProjectiles[projId] = projRecord

        local duration = math.clamp(flightTime + 0.3, 0.4, 4.0)
        task.delay(duration, function()
            if activeProjectiles[projId] == projRecord then
                activeProjectiles[projId] = nil
                activeTracerPool = math.max(0, activeTracerPool - 1)
                pModel:Destroy()
            end
        end)
    else
        -- Track impact for auto-dodge even if tracers are capped
        activeProjectiles[projId] = {
            origin = origin,
            vel = vel,
            t0 = t0 or workspace:GetServerTimeNow(),
            impactPos = impactPos,
            flightTime = flightTime,
            radius = wpn.radius
        }
        task.delay(flightTime + 0.3, function()
            if activeProjectiles[projId] then
                activeProjectiles[projId] = nil
            end
        end)
    end
end

