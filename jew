local function createToggle(text, defaultState, onClick, order, activeColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 22)
    btn.BackgroundColor3 = defaultState and (activeColor or Color3.fromRGB(24, 48, 40)) or Color3.fromRGB(22, 26, 35)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 170, 185)
    btn.Text = (defaultState and "✓ " or "✗ ") .. text
    btn.LayoutOrder = order
    btn.Parent = content

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = defaultState and Color3.fromRGB(40, 95, 75) or Color3.fromRGB(35, 42, 58)
    stroke.Thickness = 1
    stroke.Parent = btn

    local active = defaultState
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.BackgroundColor3 = active and (activeColor or Color3.fromRGB(24, 48, 40)) or Color3.fromRGB(22, 26, 35)
        btn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 170, 185)
        stroke.Color = active and Color3.fromRGB(40, 95, 75) or Color3.fromRGB(35, 42, 58)
        btn.Text = (active and "✓ " or "✗ ") .. text
        onClick(active)
    end)
    return btn
end

