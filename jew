local function sanitizePart(part)
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Anchored = true
    return part
end

-- 1. HOLOGRAPHIC AIM RETICLE GENERATOR
local function createAimReticle(id, colorTheme)
    local reticleModel = Instance.new("Model")
    reticleModel.Name = "AimReticle_" .. id
    reticleModel.Parent = visualFolder

    local bead = sanitizePart(Instance.new("Part"))
    bead.Shape = Enum.PartType.Ball
    bead.Size = Vector3.new(2, 2, 2)
    bead.Material = Enum.Material.Neon
    bead.Color = colorTheme
    bead.Transparency = 0.2
    bead.Parent = reticleModel

    local outerRing = sanitizePart(Instance.new("Part"))
    outerRing.Shape = Enum.PartType.Cylinder
    outerRing.Size = Vector3.new(0.35, 20, 20)
    outerRing.Orientation = Vector3.new(0, 0, 90)
    outerRing.Material = Enum.Material.ForceField
    outerRing.Color = colorTheme
    outerRing.Transparency = 0.35
    outerRing.Parent = reticleModel

    local box = Instance.new("SelectionBox")
    box.Adornee = outerRing
    box.Color3 = colorTheme
    box.SurfaceTransparency = 0.95
    box.LineThickness = 0.05
    box.Parent = outerRing

    local attPlane = Instance.new("Attachment")
    attPlane.Parent = visualFolder

    local attTarget = Instance.new("Attachment")
    attTarget.Parent = bead

    local beam = Instance.new("Beam")
    beam.Attachment0 = attPlane
    beam.Attachment1 = attTarget
    beam.Color = ColorSequence.new(colorTheme)
    beam.Width0 = 0.35
    beam.Width1 = 0.75
    beam.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.45),
        NumberSequenceKeypoint.new(1, 0.1)
    })
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.FaceCamera = true
    beam.Parent = reticleModel

    return {
        model = reticleModel,
        bead = bead,
        outerRing = outerRing,
        box = box,
        attPlane = attPlane,
        attTarget = attTarget,
        beam = beam
    }
end

