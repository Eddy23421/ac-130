        reticle2.outerRing.Transparency = 1
        reticle2.box.Visible = false
        reticle2.beam.Enabled = false

        coverPillar.Transparency = 1
        coverBox.Visible = false
        extractReticle.Transparency = 1
        extractBox.Visible = false

        modeBadge.Text = "LOBBY"
        modeBadge.TextColor3 = Color3.fromRGB(150, 150, 150)
        gCard1.titleLbl.Text = "GUNNER #1: STANDBY"
        gCard1.wpnLbl.Text = "Intermission"
        gCard1.distBar.Text = "Standby"
        gCard2.titleLbl.Text = "GUNNER #2: INACTIVE"
        gCard2.wpnLbl.Text = "Inactive"
        gCard2.distBar.Text = "Inactive"

        coverStatusLabel.Text = "COVER: LOBBY SAFE"
        coverStatusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        navGuideLabel.Text = "No active gunship threats."
        extractStatusLabel.Text = "EXTRACTION: INACTIVE"
        return
    end

    modeBadge.Text = isG2Active and "DOUBLE TROUBLE" or "SOLO AC-130"
    modeBadge.TextColor3 = isG2Active and Color3.fromRGB(255, 180, 50) or Color3.fromRGB(100, 200, 255)

    -- RETICLE 1
    local wpn1 = WEAPONS[g1WpnIdx] or { name = "25mm", radius = 5, color = Color3.fromRGB(255, 65, 65) }
    reticle1.bead.CFrame = CFrame.new(aim1)
    reticle1.outerRing.Size = Vector3.new(0.35, wpn1.radius * 2, wpn1.radius * 2)
    reticle1.outerRing.CFrame = CFrame.new(aim1) * CFrame.Angles(0, 0, math.rad(90))
    reticle1.attPlane.WorldPosition = plane1Pos
    reticle1.beam.Color = ColorSequence.new(wpn1.color)
    reticle1.beam.Enabled = settings.showTracerBeams

    if settings.showAimRings then
        reticle1.bead.Transparency = 0.2
        reticle1.outerRing.Transparency = 0.35
        reticle1.box.Visible = true
    end

    -- RETICLE 2
    local wpn2 = WEAPONS[g2WpnIdx] or { name = "40mm", radius = 13, color = Color3.fromRGB(255, 165, 45) }
    if isG2Active then
        reticle2.bead.CFrame = CFrame.new(aim2)
        reticle2.outerRing.Size = Vector3.new(0.35, wpn2.radius * 2, wpn2.radius * 2)
        reticle2.outerRing.CFrame = CFrame.new(aim2) * CFrame.Angles(0, 0, math.rad(90))
        reticle2.attPlane.WorldPosition = plane2Pos
        reticle2.beam.Color = ColorSequence.new(wpn2.color)
        reticle2.beam.Enabled = settings.showTracerBeams

        if settings.showAimRings then
            reticle2.bead.Transparency = 0.2
            reticle2.outerRing.Transparency = 0.35
            reticle2.box.Visible = true
        end
    else
        reticle2.bead.Transparency = 1
        reticle2.outerRing.Transparency = 1
        reticle2.box.Visible = false
        reticle2.beam.Enabled = false
    end

    -- FLIR Badges
    gCard1.thermalBadge.Text = g1Thermal and "FLIR: ACTIVE 👁️" or "FLIR: OFF"
    gCard1.thermalBadge.BackgroundColor3 = g1Thermal and Color3.fromRGB(60, 20, 20) or Color3.fromRGB(25, 30, 40)
    gCard1.thermalBadge.TextColor3 = g1Thermal and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(140, 150, 165)

    if isG2Active then
        gCard2.thermalBadge.Text = g2Thermal and "FLIR: ACTIVE 👁️" or "FLIR: OFF"
        gCard2.thermalBadge.BackgroundColor3 = g2Thermal and Color3.fromRGB(60, 20, 20) or Color3.fromRGB(25, 30, 40)
        gCard2.thermalBadge.TextColor3 = g2Thermal and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(140, 150, 165)
    else
